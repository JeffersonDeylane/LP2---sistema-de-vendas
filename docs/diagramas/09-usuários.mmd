
classDiagram
    class ServicoAutenticacao {
        -RepositorioUsuariosExcel repositorio
        +cadastrar(Usuario, String, String, String, String, String) Usuario
        +autenticar(String, String) Usuario
    }
    class RepositorioUsuariosExcel {
        -Path arquivo
        +listar() List~Usuario~
        +salvar(Usuario) void
    }
    class ServicoVendas
    class ServicoUsuarios {
        +listar(Usuario) List~Usuario~
        +alterar(Usuario, int, String, String) Usuario
        +alterarSituacao(Usuario, int, boolean) Usuario
    }

    class ServicoAutorizacao {
        +exigirContaAtiva(Usuario) Usuario
        +exigirSolicitante(Usuario, int) void
        +exigirRevisor(Usuario, Usuario) void
        +exigirResponsavelPorCancelamentoOuReativacao(Usuario) void
    }
    class ServicoImportacao
    class ServicoCancelamento

    class Usuario {
        <<abstract>>
        -int id
        -String nome
        -String login
        -String senhaHash
        -boolean ativo
        +getId() int
        +getNome() String
        +getLogin() String
        +isAtivo() boolean
        +alterarNome(String) void
        +alterarLogin(String) void
        +definirSenhaHash(String) void
        +ativar() void
        +desativar() void
        +podeSolicitarAlteracao() boolean
        +podeAprovarAlteracoes() boolean
        +podeAprovarAlteracoes(Usuario) boolean
        +podeGerenciarUsuarios() boolean
        +podeGerenciarCatalogo() boolean
    }

    class Vendedor {
        -String matricula
        +podeAprovarAlteracoes() boolean
        +podeGerenciarUsuarios() boolean
    }
    class Apoio {
        +aprovarSolicitacao(SolicitacaoAlteracao) void
        +recusarSolicitacao(SolicitacaoAlteracao, String) void
        +reativarVenda(GrupoCancelamento) void
        +podeAprovarAlteracoes() boolean
        +podeGerenciarUsuarios() boolean
    }
    class Administrador {
        +gerenciarUsuarios() void
        +gerarRelatorio() void
        +podeAprovarAlteracoes() boolean
        +podeGerenciarUsuarios() boolean
        +podeGerenciarCatalogo() boolean
    }

    Usuario <|-- Vendedor
    Usuario <|-- Apoio
    Usuario <|-- Administrador
    ServicoAutenticacao --> RepositorioUsuariosExcel
    ServicoVendas --> Usuario
    ServicoUsuarios --> RepositorioUsuariosExcel
    ServicoAutorizacao --> RepositorioUsuariosExcel
    ServicoAutenticacao --> ServicoAutorizacao
    ServicoUsuarios --> ServicoAutorizacao
    ServicoVendas --> ServicoAutorizacao
    ServicoImportacao --> ServicoAutorizacao
    ServicoCancelamento --> ServicoAutorizacao
  