classDiagram
    direction TB

    class Main
    class ServicoAutenticacao
    class ServicoVendas
    class RepositorioUsuariosExcel
    class RepositorioVendasExcel
    class ProcessadorPlanilhas

    class Usuario {
        <<abstract>>
        -int id
        -String nome
        -String login
        -String senhaHash
        -boolean ativo
        +podeAprovarAlteracoes() boolean
        +podeGerenciarUsuarios() boolean
        +podeGerenciarCatalogo() boolean
    }
    class Vendedor {
        -String matricula
    }
    class Apoio
    class Administrador
    Usuario <|-- Vendedor
    Usuario <|-- Apoio
    Usuario <|-- Administrador

    class Cliente {
        -int id
        -String identificacao
        -String nome
        -boolean ativo
    }
    class Contrato {
        -int id
        -String numero
        -int clienteId
        -boolean ativo
    }
    class Produto {
        -int id
        -String codigo
        -String nome
        -String categoria
        -BigDecimal preco
        -String unidade
        -boolean permiteFracao
        -boolean ativo
    }
    class ItemVenda {
        -int id
        -int produtoId
        -BigDecimal quantidade
        -String codigoProduto
        -String nomeProduto
        -String categoria
        -String unidade
        -BigDecimal precoUnitario
        -BigDecimal subtotal
    }
    class Venda {
        -int id
        -int clienteId
        -int vendedorId
        -Integer contratoId
        -LocalDateTime criadaEm
        -LocalDateTime confirmadaEm
        -EstadoVenda estado
        -List~ItemVenda~ itens
        -BigDecimal total
    }
    class EstadoVenda {
        <<enumeration>>
        RASCUNHO
        CONFIRMADA
    }

    class OperacaoComercial {
        <<abstract>>
        -Long id
        -LocalDate dataCadastro
    }
    class VendaComercial {
        <<esqueleto>>
    }
    class MudancaTecnologia {
        <<esqueleto>>
    }
    class SeletorProdutoPrincipal {
        <<esqueleto>>
        +selecionar(Contrato) ItemVenda
    }

    Main --> ServicoAutenticacao
    Main --> ServicoVendas
    Main --> ProcessadorPlanilhas
    ServicoAutenticacao --> RepositorioUsuariosExcel
    ServicoVendas --> RepositorioVendasExcel
    ServicoVendas --> RepositorioUsuariosExcel
    OperacaoComercial <|-- VendaComercial
    OperacaoComercial <|-- MudancaTecnologia
    VendaComercial --> Contrato
    Cliente "1" --> "0..*" Contrato
    Cliente "1" --> "0..*" Venda
    Venda "0..*" --> "0..1" Contrato : contratoId opcional
    Venda "0..*" --> "1" Vendedor : vendedorId
    Venda "1" *-- "0..*" ItemVenda
    ItemVenda "*" --> "1" Produto
    Venda --> EstadoVenda
    OperacaoComercial --> Vendedor : responsavel
    Contrato ..> SeletorProdutoPrincipal

    note for OperacaoComercial "Esqueleto ainda nao conectado ao fluxo ativo de vendas."
