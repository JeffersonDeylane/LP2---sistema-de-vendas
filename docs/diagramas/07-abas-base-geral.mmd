    }
    SOLICITACOES {
        string solicitacao_id PK
        string contrato_id FK
        string solicitante_id FK
        string status
    }
    DECISOES {
        string decisao_id PK
        string solicitacao_id FK
        string usuario_id FK
        string resultado
    }
    HISTORICO {
        string historico_id PK
        string contrato_id FK
        string usuario_id FK
        string campo
        string valor_anterior
        string valor_novo
        datetime data_hora
    }
    GRUPOS_CANCELAMENTO {
        string grupo_id PK
        string contrato_id FK
        string responsavel_id FK
    }
    ITENS_CANCELADOS {
        string registro_id PK
        string grupo_id FK
        string item_id FK
        boolean reativado
    }
    IMPORTACOES {
        string lote_id PK
        string nome_arquivo
        datetime data_importacao
    }
